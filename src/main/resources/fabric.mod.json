{
  "schemaVersion": 1,
  "id": "ycpk",
  "version": "${version}",
  "name": "Sculk&Jaw",
  "description": "This mod expanded sculk blocks family and add few new effects, Ancient City and Deep Dark is more dangerous now.",
  "authors": [
    {
      "name": "Cheesecuter"
    },
    {
      "name": "WuYuZeGang"
    }
  ],
  "contributors": [
    {
        "name": "The1Yang1"
    },
    {
      "name": "yoyolyq"
    },
    {
      "name": "JoanDaro"
    }
  ],
  "contact": {
    "sources": "https://github.com/Cheesecuter/SculkJaw",
    "issues": "https://github.com/Cheesecuter/SculkJaw/issues"
  },
  "license": "AGPL-3.0-only",
  "icon": "assets/ycpk/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "ycpk.sculkandjaw.client.SculkAndJawDataGenerator"
    ],
    "client": [
      "ycpk.sculkandjaw.client.SculkAndJawClient"
    ],
    "main": [
      "ycpk.sculkandjaw.SculkAndJaw"
    ]
  },
  "mixins": [
    "sculkandjaw.mixins.json",
    {
      "config": "sculkandjaw.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "https://legacy.curseforge.com/minecraft/mc-mods/sculkandjaw"
      },
      "update_checker": true
    }
  }
}
