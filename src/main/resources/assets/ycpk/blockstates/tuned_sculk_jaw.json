{
  "multipart": [
    {
      "apply": {
        "model": "ycpk:block/tuned_sculk_jaw",
        "x": 90
      },
      "when": {
        "facing": "north",
        "bite_state": "not_bite"
      }
    },
    {
      "apply": {
        "model": "ycpk:block/tuned_sculk_jaw",
        "x": 90,
        "y": 90
      },
      "when": {
        "facing": "east",
        "bite_state": "not_bite"
      }
    },
    {
      "apply": {
        "model": "ycpk:block/tuned_sculk_jaw",
        "x": 90,
        "y": 180
      },
      "when": {
        "facing": "south",
        "bite_state": "not_bite"
      }
    },
    {
      "apply": {
        "model": "ycpk:block/tuned_sculk_jaw",
